<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="client.controller.AdminController" styleClass="page">
    <top>
        <HBox styleClass="topbar" spacing="10" alignment="CENTER_LEFT">
            <Button text="← Danh sách" onAction="#back"/>
            <Label text="Quản trị hệ thống" styleClass="brand"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Tải lại" onAction="#reload"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="10">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <Label text="Tài khoản" styleClass="section-title"/>
            <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="userNameColumn" text="Họ tên" prefWidth="200"/>
                    <TableColumn fx:id="userPhoneColumn" text="Số điện thoại" prefWidth="130"/>
                    <TableColumn fx:id="userRoleColumn" text="Vai trò" prefWidth="110"/>
                    <TableColumn fx:id="userStatusColumn" text="Trạng thái" prefWidth="110"/>
                    <TableColumn fx:id="userBalanceColumn" text="Số dư" prefWidth="140"/>
                </columns>
            </TableView>
            <HBox spacing="8">
                <Button fx:id="banButton" text="Khóa tài khoản" styleClass="danger" onAction="#ban"/>
                <Button fx:id="unbanButton" text="Mở khóa" onAction="#unban"/>
            </HBox>
            <Label text="Phiên đấu giá" styleClass="section-title"/>
            <TableView fx:id="auctionTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="auctionNameColumn" text="Sản phẩm" prefWidth="220"/>
                    <TableColumn fx:id="auctionSellerColumn" text="Người bán" prefWidth="160"/>
                    <TableColumn fx:id="auctionPriceColumn" text="Giá hiện tại" prefWidth="130"/>
                    <TableColumn fx:id="auctionStatusColumn" text="Trạng thái" prefWidth="110"/>
                </columns>
            </TableView>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="cancelAuctionButton" text="Hủy phiên" styleClass="danger" onAction="#cancelAuction"/>
                <Label fx:id="messageLabel" styleClass="message" wrapText="true"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
