<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<VBox xmlns:fx="http://javafx.com/fxml/1" spacing="12">
 <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
 <Label text="ĐĂNG NHẬP"/>
 <TextField fx:id="phoneField" promptText="Số điện thoại"/>
 <PasswordField fx:id="passwordField" promptText="Mật khẩu"/>
 <Button text="Đăng nhập" onAction="#login"/>
 <Label fx:id="message"/>
</VBox>
