<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Cấu hình Checkstyle cho dự án Online-Auction-System.
  Giữ nhẹ nhàng để không phá vỡ code hiện có, chỉ kiểm tra các quy tắc cơ bản.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>

    <!-- Không cho phép tab trong file -->
    <module name="FileTabCharacter"/>

    <module name="TreeWalker">
        <!-- Không cho phép import không dùng đến -->
        <module name="UnusedImports"/>

        <!-- Không cho phép khai báo biến không dùng -->
        <module name="UnusedLocalVariable"/>

        <!-- Mỗi file chỉ có một lớp public -->
        <module name="OneTopLevelClass"/>

        <!-- Không cho phép dấu chấm phẩy thừa -->
        <module name="EmptyStatement"/>

        <!-- Khối try/catch/finally phải có dấu ngoặc -->
        <module name="NeedBraces"/>

        <!-- Không cho phép so sánh bằng == với String -->
        <module name="StringLiteralEquality"/>

        <!-- Không cho phép gán trong điều kiện -->
        <module name="InnerAssignment"/>
    </module>
</module>